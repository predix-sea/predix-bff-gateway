# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL (audit log)
DATABASE_URL=jdbc:postgresql://localhost:5432/predix_bff
DATABASE_USERNAME=predix
DATABASE_PASSWORD=predix

# JWT / Session
JWT_SECRET=change-me-in-production-use-256-bit-secret-key!!
JWT_ACCESS_TTL=PT24H

# SIWE
SIWE_DOMAIN=predix.local
SIWE_URI=https://predix.local

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# Compliance
GEOIP_DB_PATH=/path/to/GeoLite2-Country.mmdb

# Downstream services
MARKET_SCHEMA_URL=http://localhost:8081
MATCHING_URL=http://localhost:8082
BACP_URL=http://localhost:8083
INDEXER_URL=http://localhost:8084
ORACLE_OPS_URL=http://localhost:8085
